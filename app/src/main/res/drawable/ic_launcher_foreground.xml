<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Outer Hastradar Concentric Pulse Ring (Cyan-Violet) -->
    <path
        android:pathData="M 22,54 A 32,32 0 1,1 78,28"
        android:strokeWidth="7"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="22"
                android:startY="54"
                android:endX="78"
                android:endY="28"
                android:type="linear">
                <item android:color="#FF00F2FE" android:offset="0.0"/>
                <item android:color="#FF4FACFE" android:offset="0.5"/>
                <item android:color="#FFA855F7" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Inner Hastradar Radar Pulse Arc -->
    <path
        android:pathData="M 34,66 A 20,20 0 0,1 66,34"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="66"
                android:endX="66"
                android:endY="34"
                android:type="linear">
                <item android:color="#FF38BDF8" android:offset="0.0"/>
                <item android:color="#FF818CF8" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Upward Financial Growth Arrow -->
    <path
        android:pathData="M 32,70 L 48,54 L 58,62 L 78,36 M 66,36 L 79,34 L 77,48"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="70"
                android:endX="78"
                android:endY="34"
                android:type="linear">
                <item android:color="#FF10B981" android:offset="0.0"/>
                <item android:color="#FF34D399" android:offset="0.6"/>
                <item android:color="#FF059669" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. AI Spark Star at Top Center -->
    <path
        android:pathData="M 54,20 C 54,26 59,30 64,30 C 59,30 54,34 54,40 C 54,34 49,30 44,30 C 49,30 54,26 54,20 Z"
        android:fillColor="#FFD8B4FE" />

</vector>
