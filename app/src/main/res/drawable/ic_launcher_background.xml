<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dark Navy Base Layer -->
    <path
        android:pathData="M 0,0 L 108,0 L 108,108 L 0,108 Z"
        android:fillColor="#0A0F1D" />

    <!-- Ambient Glowing Ring behind Emblem -->
    <path
        android:pathData="M 54,18 A 36,36 0 1,1 53.99,18 Z"
        android:strokeWidth="12"
        android:strokeAlpha="0.25">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="40"
                android:type="radial">
                <item android:color="#FF6366F1" android:offset="0.0"/>
                <item android:color="#FF06B6D4" android:offset="0.7"/>
                <item android:color="#000A0F1D" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Metallic Crosslines -->
    <path
        android:pathData="M 18,54 L 90,54 M 54,18 L 54,90"
        android:strokeColor="#1E293B"
        android:strokeWidth="1"
        android:strokeAlpha="0.4" />

</vector>
